# Copy this file to server/.env and fill in YOUR OWN secret values.
# server/.env is git-ignored and must never be committed.
# In production (Render) set these same variables in the dashboard instead
# of using a file.

# Perks tokens - players type these into the "Token" box on the login
# screen to unlock their perk/admin tier. Give each holder their own token.
BETA_TESTER=change_me_beta_token
SHINY=change_me_shiny_token
YOUTUBER=change_me_youtuber_token
DEVELOPER=change_me_developer_token

# Shared secret between game servers. Used to authorize /api/sendPlayer
# (player travel between servers). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=change_me_api_key

# ---------------------------------------------------------------------------
# Accounts (server/accounts). Everything below is optional in local dev.
# ---------------------------------------------------------------------------

# The public URL players load the game from (scheme + host, no path).
# Cookies, the CSRF Origin check and the Discord redirect all derive from it.
# Default: https://$PUBLIC_HOST if PUBLIC_HOST is set, else
# http://localhost:$PORT. Over https the session cookie is __Host-dw_sid
# (Secure); over http it is dw_sid.
# Changing it later logs everybody out (cookies are tied to the host).
# Production: PUBLIC_ORIGIN=https://corez.io (and PUBLIC_HOST=corez.io)
PUBLIC_ORIGIN=

# The old domain(s) the site moved from (comma list, host only; www. is
# added automatically). Page loads there get a small moving page that hands
# the browser's localStorage and login cookie over to PUBLIC_ORIGIN through a
# one-time code, then sends it on. The API, websockets, assets and Discord
# endpoints keep answering on the old host, and its origin stays allowed.
# Keep the old host's /auth/discord/callback registered with Discord: a login
# started there finishes there.
# Production: MOVE_FROM_HOST=corez.games
MOVE_FROM_HOST=

# Extra origins allowed to call the /api/* write endpoints (comma list).
# Outside production any http://localhost:* and http://127.0.0.1:* page is
# allowed automatically.
ALLOWED_ORIGINS=

# Reverse proxies whose X-Forwarded-For header is believed (comma list of IPs
# or CIDRs). Put Caddy's address here; the server logs an untrusted proxy's
# address when it sees one. Default: 127.0.0.1,::1 (loopback is always
# trusted on top of whatever is listed).
# If this is wrong, every player looks like the proxy: they all share one set
# of login rate limits and one person can lock everybody out (in production
# the accounts server says so once, loudly, in the error log).
# Hack Club Nest: Caddy connects from 10.60.1.2, so production sets
#   TRUSTED_PROXIES=10.60.1.2
# Trust exactly that address, never 10.60.0.0/16: other people's containers
# share that range and could connect directly with a forged X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Signs the short-lived Discord login cookies. At least 32 characters.
# In production (NODE_ENV=production, or PUBLIC_HOST set to a real domain)
# accounts are DISABLED without it and the game runs guest-only. In dev a
# random per-boot secret is used when it is unset. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Where the SQLite database and its backups live. Created with mode 0700; the
# database file is chmod 0600. Must survive redeploys (keep it outside the
# checkout or at least never delete it). Defaults: <repo>/data and
# $DATA_DIR/digwars.db. Pre-migration copies go to $DATA_DIR/backups/.
DATA_DIR=
DB_PATH=

# Master switch. false = no accounts at all: /api/config says accounts:false
# and the game is guest-only. Default: true
ACCOUNTS_ENABLED=true

# production = strict mode (no localhost origins, SESSION_SECRET required).
# Setting PUBLIC_HOST to a non-localhost host also counts as production.
NODE_ENV=

# "Log in with Discord" (OAuth2, identify scope only). Leave the ID or the
# secret empty to hide the Discord button. From
# https://discord.com/developers/applications -> your app -> OAuth2.
# Add PUBLIC_ORIGIN/auth/discord/callback (and
# http://localhost:3000/auth/discord/callback for local testing) under
# Redirects there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional; default PUBLIC_ORIGIN + /auth/discord/callback. Must match one of
# the Redirects registered with Discord exactly.
DISCORD_REDIRECT_URI=

# Item Shop rotation seed. The daily rotation is mulberry32(fnv1a(salt + day))
# and is stored in shop_rotations once computed, so changing this only
# affects days not yet generated. Default: dw-shop-v1
SHOP_SEED_SALT=

# ---------------------------------------------------------------------------
# Discord bot (slash commands over HTTP interactions, announcements, backup
# uploads). All optional; each feature stays off until its values are set.
# From https://discord.com/developers/applications -> your app.
# ---------------------------------------------------------------------------

# General Information -> Application ID and Public Key (64 hex chars).
# Both are needed for POST /discord/interactions to answer. Then set the
# Interactions Endpoint URL there to PUBLIC_ORIGIN/discord/interactions.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Bot -> Reset Token. Needed for announcements, backup uploads and
# scripts/discord-register.js. No privileged intents are used.
DISCORD_BOT_TOKEN=
# Your Discord server's id (Developer Mode -> right-click the server -> Copy
# Server ID). The admin commands are registered there only.
DISCORD_ADMIN_GUILD_ID=
# Comma list of Discord user ids allowed to run the admin commands
# (/lookup /resetpassword /relink /grantdust /ban /unban /users /history
# /guests /stats /dust /shoprotate /feedback).
ADMIN_DISCORD_IDS=
# Public channel for rank-ups (Diamond I and up, Legend) and raid top 3s.
DISCORD_ANNOUNCE_CHANNEL_ID=
# PRIVATE channel that receives the nightly encrypted backup files.
DISCORD_BACKUP_CHANNEL_ID=
# Optional PRIVATE channel for player feedback from the menu. Empty = the
# backup channel above. Posting is best effort; a bad id is just logged.
DISCORD_FEEDBACK_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Nightly encrypted backups (data/backups/, and the Discord channel above).
# ---------------------------------------------------------------------------

# 32 random bytes, base64 or hex:  openssl rand -base64 32
# KEEP A COPY SOMEWHERE OTHER THAN THIS SERVER: without it the backups
# cannot be decrypted. Unset = no backups.
# Restore: node scripts/restore-backup.js <file.dwb> [out.db]
BACKUP_ENCRYPTION_KEY=
# Hour (UTC, 0-23) the nightly backup runs. Default: 3. A backup also runs
# 5 minutes after boot when the last one is more than 26 hours old.
BACKUP_HOUR_UTC=3

# ---------------------------------------------------------------------------
# Dig Royale: dash and abilities (server/game/terrain/abilities.js)
# ---------------------------------------------------------------------------

# 0 = no dash, no ability slot, and the shop goes back to the old list
# (the timed +25% gear, Support Strut, Overdrive Core, Magnet Storm twist).
# Default on.
ROYALE_ABILITIES=1
# 0 = no free 2 minute ability trial on a player's first bank of a raid.
# Default on.
ROYALE_ABILITY_TRIAL=1

# ---------------------------------------------------------------------------
# Raid features. All on by default; set one to 0 to switch it off fast.
# ---------------------------------------------------------------------------

# Big carriers get marked on every map (HUNTED at 1500 carried, TOP TARGET
# for the biggest haul over 2500) and killing one pays a bounty.
ROYALE_HUNTED=1
# The Core: the last storm's objective beside the Center Vault. Off = the
# final circle goes back to a random centre.
ROYALE_CORE=1
# Meteor drop-in landings (rock smashed around you, gems on your first drop).
ROYALE_DROPIN=1
# A new player who has not banked yet lands near a vault.
ROYALE_FIRST_VAULT=1
# The Rattler: a slow digger that chases a new player carrying gems.
ROYALE_RATTLER=1

# ---------------------------------------------------------------------------
# Dig Royale: bots and bosses. All on by default; 0 switches one off.
# ---------------------------------------------------------------------------

# Lock-on difficulty (server/miscFiles/botDifficulty.js): new players keep
# the easy bots, everyone else climbs to full lock-on (ranked players at
# once, guests by 15 minutes of play). 0 = the old, softer curve.
ROYALE_BOTS_LOCKON=1
# Lock-on bots fight like players: sidestep shots, duck behind rock and
# peek, run down fleeing carriers, come back after healing, third-party
# fights, dash. 0 = none of that (aim and targeting stay).
ROYALE_BOT_TACTICS=1
# Bots go after the biggest satchels and the HUNTED mark. 0 = the old small
# pull toward carriers.
ROYALE_BOT_HUNT=1
# Raid bots spawn as tier 3 tanks from a fixed pool (miscFiles/botTanks.js,
# BOT_TANK_CHECKLIST.md still applies). 0 = the old random upgrade walk.
ROYALE_BOT_T3=1
# How often bosses come, as a multiple of the old pace (1 = about one a
# raid). Warden's Watch multiplies on top. Default 2.5.
ROYALE_BOSS_RATE=2.5
# Bosses take damage in measured doses (terrain/bossGuard.js: 1.75% of the
# pool a hit, 2.8% a second per tank, 7.5% a second in all, no regen under
# fire). 0 = off (a Constructor kills one in about a second).
ROYALE_BOSS_CAP=1
# Bosses go easy on new players: their shots and hull hit a newcomer for a
# quarter (back to full as the newcomer window fades), never take them under
# 1 health unless they shot the boss in the last 8 s, and boss guns take
# anyone else in reach first. 0 = bosses treat everyone the same.
ROYALE_BOSS_NEWBIE=1
# Per-class damage into other tanks (terrain/classBalance.js: pounder line,
# Constructor and Octo Tank softer, Penta Shot harder). 0 turns it off.
ROYALE_CLASS_BALANCE=1
# Raid bots carry dash plus one secondary ability suited to their tank
# (smoke, shockwave, grapple, launch pad, barricade, adrenaline, radar,
# burrow) and use them in fights; never offensively on a newcomer.
# 0 = no secondary and no bot dashes.
ROYALE_BOT_ABILITIES=1
# 0 = no free random ability on a player's first spawn of each raid.
# Default on.
ROYALE_FREE_ABILITY=1
# Supply crates falling out of the sky every minute or so (a new ability inside).
ROYALE_SUPPLY=1
# A soft azurite vein (sometimes a shard) by every drop pit at raid start.
ROYALE_EARLY_ORE=1
# The meteor shower round the busiest player 1:30 into a raid.
ROYALE_RUSH=1
# Spawns land near the action (a fight, a vault, rich ore), 520-900 from any
# enemy. New players keep the near-vault landing.
ROYALE_ACTION_SPAWN=1
# Raid bots respawn as themselves (same name, tank, ability and board row)
# 4.5-7 s after dying, never in the storm's spawn lock. 0 = a dead bot's
# slot gets a new bot again (still never instantly).
ROYALE_BOT_ROSTER=1
