# Copy this file to server/.env and fill in YOUR OWN secret values.
# server/.env is git-ignored and must never be committed.
# In production (Render) set these same variables in the dashboard instead
# of using a file.

# Perks tokens - players type these into the "Token" box on the login
# screen to unlock their perk/admin tier. Give each holder their own token.
BETA_TESTER=change_me_beta_token
SHINY=change_me_shiny_token
YOUTUBER=change_me_youtuber_token
DEVELOPER=change_me_developer_token

# Shared secret between game servers. Used to authorize /api/sendPlayer
# (player travel between servers). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=change_me_api_key

# ---------------------------------------------------------------------------
# Accounts (server/accounts). Everything below is optional in local dev.
# ---------------------------------------------------------------------------

# The public URL players load the game from (scheme + host, no path).
# Cookies, the CSRF Origin check and the Discord redirect all derive from it.
# Default: https://$PUBLIC_HOST if PUBLIC_HOST is set, else
# http://localhost:$PORT. Over https the session cookie is __Host-dw_sid
# (Secure); over http it is dw_sid.
# Changing it later logs everybody out (cookies are tied to the host).
# Production: PUBLIC_ORIGIN=https://digwars.hackclub.app
PUBLIC_ORIGIN=

# Extra origins allowed to call the /api/* write endpoints (comma list).
# Outside production any http://localhost:* and http://127.0.0.1:* page is
# allowed automatically.
ALLOWED_ORIGINS=

# Reverse proxies whose X-Forwarded-For header is believed (comma list of IPs
# or CIDRs). Put Caddy's address here; the server logs an untrusted proxy's
# address when it sees one. Default: 127.0.0.1,::1 (loopback is always
# trusted on top of whatever is listed).
# If this is wrong, every player looks like the proxy: they all share one set
# of login rate limits and one person can lock everybody out (in production
# the accounts server says so once, loudly, in the error log).
# Hack Club Nest: Caddy connects from 10.60.1.2, so production sets
#   TRUSTED_PROXIES=10.60.1.2
# Trust exactly that address, never 10.60.0.0/16: other people's containers
# share that range and could connect directly with a forged X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Signs the short-lived Discord login cookies. At least 32 characters.
# In production (NODE_ENV=production, or PUBLIC_HOST set to a real domain)
# accounts are DISABLED without it and the game runs guest-only. In dev a
# random per-boot secret is used when it is unset. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Where the SQLite database and its backups live. Created with mode 0700; the
# database file is chmod 0600. Must survive redeploys (keep it outside the
# checkout or at least never delete it). Defaults: <repo>/data and
# $DATA_DIR/digwars.db. Pre-migration copies go to $DATA_DIR/backups/.
DATA_DIR=
DB_PATH=

# Master switch. false = no accounts at all: /api/config says accounts:false
# and the game is guest-only. Default: true
ACCOUNTS_ENABLED=true

# production = strict mode (no localhost origins, SESSION_SECRET required).
# Setting PUBLIC_HOST to a non-localhost host also counts as production.
NODE_ENV=

# "Log in with Discord" (OAuth2, identify scope only). Leave the ID or the
# secret empty to hide the Discord button. From
# https://discord.com/developers/applications -> your app -> OAuth2.
# Add PUBLIC_ORIGIN/auth/discord/callback (and
# http://localhost:3000/auth/discord/callback for local testing) under
# Redirects there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional; default PUBLIC_ORIGIN + /auth/discord/callback. Must match one of
# the Redirects registered with Discord exactly.
DISCORD_REDIRECT_URI=

# Item Shop rotation seed. The daily rotation is mulberry32(fnv1a(salt + day))
# and is stored in shop_rotations once computed, so changing this only
# affects days not yet generated. Default: dw-shop-v1
SHOP_SEED_SALT=

# ---------------------------------------------------------------------------
# Discord bot (slash commands over HTTP interactions, announcements, backup
# uploads). All optional; each feature stays off until its values are set.
# From https://discord.com/developers/applications -> your app.
# ---------------------------------------------------------------------------

# General Information -> Application ID and Public Key (64 hex chars).
# Both are needed for POST /discord/interactions to answer. Then set the
# Interactions Endpoint URL there to PUBLIC_ORIGIN/discord/interactions.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Bot -> Reset Token. Needed for announcements, backup uploads and
# scripts/discord-register.js. No privileged intents are used.
DISCORD_BOT_TOKEN=
# Your Discord server's id (Developer Mode -> right-click the server -> Copy
# Server ID). The admin commands are registered there only.
DISCORD_ADMIN_GUILD_ID=
# Comma list of Discord user ids allowed to run the admin commands
# (/lookup /resetpassword /relink /grantdust /ban /unban).
ADMIN_DISCORD_IDS=
# Public channel for rank-ups (Diamond I and up, Legend) and raid top 3s.
DISCORD_ANNOUNCE_CHANNEL_ID=
# PRIVATE channel that receives the nightly encrypted backup files.
DISCORD_BACKUP_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Nightly encrypted backups (data/backups/, and the Discord channel above).
# ---------------------------------------------------------------------------

# 32 random bytes, base64 or hex:  openssl rand -base64 32
# KEEP A COPY SOMEWHERE OTHER THAN THIS SERVER: without it the backups
# cannot be decrypted. Unset = no backups.
# Restore: node scripts/restore-backup.js <file.dwb> [out.db]
BACKUP_ENCRYPTION_KEY=
# Hour (UTC, 0-23) the nightly backup runs. Default: 3. A backup also runs
# 5 minutes after boot when the last one is more than 26 hours old.
BACKUP_HOUR_UTC=3
